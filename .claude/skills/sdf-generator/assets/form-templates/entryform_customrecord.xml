<entryForm scriptid="{{scriptid}}" standard="{{standard}}">
  <name>{{name}}</name>
  <recordType>[scriptid={{recordtype}}]</recordType>
  <inactive>F</inactive>
  <preferred>{{preferred}}</preferred>
  <storedWithRecord>F</storedWithRecord>
  <mainFields>
    <defaultFieldGroup>
      <fields position="MIDDLE">
        <field>
          <id>CUSTOMFORM</id>
          <label>Formulário personalizado</label>
          <visible>T</visible>
          <mandatory>T</mandatory>
          <displayType>NORMAL</displayType>
          <columnBreak>F</columnBreak>
          <sameRowAsPrevious>F</sameRowAsPrevious>
          <quickAdd>F</quickAdd>
        </field>
        <field>
          <id>NAME</id>
          <label>Nome</label>
          <visible>T</visible>
          <mandatory>T</mandatory>
          <displayType>NORMAL</displayType>
          <columnBreak>F</columnBreak>
          <sameRowAsPrevious>F</sameRowAsPrevious>
          <quickAdd>T</quickAdd>
        </field>
        <field>
          <id>RECORDID</id>
          <label>ID</label>
          <visible>T</visible>
          <mandatory>T</mandatory>
          <displayType>NORMAL</displayType>
          <columnBreak>F</columnBreak>
          <sameRowAsPrevious>F</sameRowAsPrevious>
          <quickAdd>F</quickAdd>
        </field>
        <field>
          <id>OWNER</id>
          <label>Proprietário</label>
          <visible>T</visible>
          <mandatory>T</mandatory>
          <displayType>NORMAL</displayType>
          <columnBreak>F</columnBreak>
          <sameRowAsPrevious>F</sameRowAsPrevious>
          <quickAdd>F</quickAdd>
        </field>
        <field>
          <id>CREATED</id>
          <label>Data de criação</label>
          <visible>T</visible>
          <mandatory>T</mandatory>
          <displayType>NORMAL</displayType>
          <columnBreak>F</columnBreak>
          <sameRowAsPrevious>F</sameRowAsPrevious>
          <quickAdd>F</quickAdd>
        </field>
        <field>
          <id>LASTMODIFIED</id>
          <label>Última alteração</label>
          <visible>T</visible>
          <mandatory>T</mandatory>
          <displayType>NORMAL</displayType>
          <columnBreak>F</columnBreak>
          <sameRowAsPrevious>F</sameRowAsPrevious>
          <quickAdd>F</quickAdd>
        </field>
        <field>
          <id>ISINACTIVE</id>
          <label>Inativo</label>
          <visible>T</visible>
          <mandatory>F</mandatory>
          <displayType>NORMAL</displayType>
          <columnBreak>F</columnBreak>
          <sameRowAsPrevious>F</sameRowAsPrevious>
          <quickAdd>F</quickAdd>
        </field>
        <field>
          <id>PARENT</id>
          <label>Controladora</label>
          <visible>T</visible>
          <mandatory>F</mandatory>
          <displayType>NORMAL</displayType>
          <columnBreak>F</columnBreak>
          <sameRowAsPrevious>F</sameRowAsPrevious>
          <quickAdd>F</quickAdd>
        </field>
      </fields>
    </defaultFieldGroup>
  </mainFields>
  <tabs>
    <tab>
      <id>RECORDMEDIA</id>
      <label>Arquivos</label>
      <fieldGroups>
        <defaultFieldGroup/>
      </fieldGroups>
      <subItems>
        <subList>
          <id>RECORDMEDIAITEM</id>
          <label>Files</label>
          <neverEmpty>F</neverEmpty>
        </subList>
      </subItems>
    </tab>
    <tab>
      <id>RECORDNOTES</id>
      <label>Notas</label>
      <fieldGroups>
        <defaultFieldGroup/>
      </fieldGroups>
      <subItems>
        <subList>
          <id>RECORDUSERNOTES</id>
          <label>User Notes</label>
          <neverEmpty>F</neverEmpty>
        </subList>
        <subList>
          <id>RECORDSYSTEMNOTES</id>
          <label>System Notes</label>
          <neverEmpty>F</neverEmpty>
        </subList>
      </subItems>
    </tab>
  </tabs>
  <actionbar>
    <menu>
      <menuitem>
        <id>MAKECOPY</id>
        <label>Criar cópia</label>
      </menuitem>
      <menuitem>
        <id>DELETE</id>
        <label>Excluir</label>
      </menuitem>
      <menuitem>
        <id>PRINT</id>
        <label>Imprimir</label>
      </menuitem>
      <menuitem>
        <id>NEW</id>
        <label>Novo</label>
      </menuitem>
      <menuitem>
        <id>SUBMITAS</id>
        <label>Salvar como</label>
      </menuitem>
      <menuitem>
        <id>SUBMITCOPY</id>
        <label>Salvar e copiar</label>
      </menuitem>
      <menuitem>
        <id>SUBMITNEW</id>
        <label>Salvar e novo</label>
      </menuitem>
      <menuitem>
        <id>SUBMITNEXT</id>
        <label>Salvar e próximo</label>
      </menuitem>
    </menu>
  </actionbar>
  <editingInList>T</editingInList>
</entryForm>
