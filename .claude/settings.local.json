{
  "permissions": {
    "allow": [
      "Skill(spec-standards)",
      "Skill(manifest-standards)",
      "Skill(usecase-architecture)",
      "Skill(deploy)",
      "Skill(sdf-generator)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(suitecloud --version)",
      "Bash(suitecloud account:manageauth --list)",
      "Bash(suitecloud file:upload *)",
      "Bash(suitecloud project:validate *)",
      "Bash(suitecloud project:deploy *)",
      "Bash(suitecloud project:adddependencies)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/on-spec-saved.sh \"$CLAUDE_TOOL_INPUT_FILE_PATH\""
          }
        ]
      }
    ]
  }
}