{
  "permissions": {
    "allow": [
      "Skill(spec-standards)",
      "Skill(manifest-standards)",
      "Skill(usecase-architecture)",
      "Skill(deploy)",
      "Skill(sdf-generator)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(suitecloud --version)",
      "Bash(suitecloud account:manageauth --list)",
      "Bash(suitecloud file:upload *)",
      "Bash(suitecloud project:validate *)",
      "Bash(suitecloud project:deploy *)",
      "Bash(suitecloud project:adddependencies)",
      "PowerShell(Out-Null *)",
      "Bash(python -c ' *)",
      "Bash(python -c \"import xml.etree.ElementTree as ET; ET.parse\\('customrecord_pd_pya_exchanges.xml'\\); print\\('XML well-formed \\(ElementTree\\)'\\)\")",
      "Bash(python3 -c \"import xml.etree.ElementTree as ET; ET.parse\\('customrecord_pd_pya_exchanges.xml'\\); print\\('XML well-formed \\(ElementTree\\)'\\)\")",
      "Bash(printf '<deploy>\\\\r\\\\n    <objects>\\\\r\\\\n        <path>~/Objects/customrecord_pd_pya_neutralizations.xml</path>\\\\r\\\\n    </objects>\\\\r\\\\n</deploy>\\\\r\\\\n')",
      "Bash(xxd src/deploy.xml)",
      "PowerShell(suitecloud account:manageauth *)",
      "Bash(suitecloud account:setup --help)",
      "Bash(suitecloud --help)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/on-spec-saved.sh \"$CLAUDE_TOOL_INPUT_FILE_PATH\""
          }
        ]
      }
    ]
  }
}
