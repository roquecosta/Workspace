<mapreducescript scriptid="{{scriptid}}">
  <description>{{description}}</description>
  <isinactive>F</isinactive>
  <name>{{name}}</name>
  <notifyadmins>F</notifyadmins>
  <notifyemails></notifyemails>
  <notifyowner>T</notifyowner>
  <scriptfile>{{scriptfile}}</scriptfile>
  {{scriptcustomfields}}
  <scriptdeployments>
    <scriptdeployment scriptid="{{deployid}}">
      <buffersize>1</buffersize>
      <concurrencylimit>1</concurrencylimit>
      {{deployment_params}}
      <isdeployed>T</isdeployed>
      <loglevel>{{loglevel}}</loglevel>
      <queueallstagesatonce>T</queueallstagesatonce>
      <runasrole>ADMINISTRATOR</runasrole>
      <status>{{status}}</status>
      <title>{{name}}</title>
      <yieldaftermins>60</yieldaftermins>
      <recurrence>
        <single>
          <repeat></repeat>
          <startdate>{{startdate}}</startdate>
          <starttime>00:00:00Z</starttime>
        </single>
      </recurrence>
    </scriptdeployment>
  </scriptdeployments>
</mapreducescript>
